# Core: use local content without Sanity, or set CONTENT_SOURCE to sanity.
CONTENT_SOURCE=
# Public identifiers shared by Studio, content reads, images and CLI.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Same private dataset name in both; it must differ from the content dataset.
NEXT_PUBLIC_SANITY_SUBMISSIONS_DATASET=
SANITY_SUBMISSIONS_DATASET=
# Server-only writer with permission for the private submissions dataset.
SANITY_WRITE_TOKEN=

# Existing notification provider: Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
